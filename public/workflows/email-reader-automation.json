      "webhookId": "c3fafede-2be8-4bcb-bf0a-30e14c946b60"
    },
    {
      "parameters": {
        "jsCode": "// Combine all fetched emails into a single numbered text block for the AI to read\nconst items = $input.all();\n\nif (items.length === 0) {\n  return [{ json: { emailBlock: 'NO_EMAILS', count: 0 } }];\n}\n\nconst lines = items.map((item, i) => {\n  const j = item.json;\n  const subject = j.subject || j.payload?.headers?.find(h => h.name === 'Subject')?.value || '(no subject)';\n  const from = j.from || j.payload?.headers?.find(h => h.name === 'From')?.value || '(unknown sender)';\n  const snippet = (j.snippet || '').replace(/\\s+/g, ' ').trim();\n  return `${i + 1}. From: ${from}\\n   Subject: ${subject}\\n   Preview: ${snippet}`;\n});\n\nreturn [{ json: { emailBlock: lines.join('\\n\\n'), count: items.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        96
      ],
      "id": "a367088e-3d52-4469-bbef-5f312a564b4d",
      "name": "Combine Emails Into Text"
    },
    {
