          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "no-emails-check",
              "leftValue": "={{ $json.emailBlock }}",
              "rightValue": "NO_EMAILS",
              "operator": {
