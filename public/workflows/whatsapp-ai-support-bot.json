      },
      "id": "c0fa4e6b-ee12-4df3-adaf-254f83d68a62",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        2048,
        1264
      ],
      "webhookId": "whatsapp-agent-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Normalize incoming WhatsApp payload\nconst body = items[0].json;\nconst entry = body.entry && body.entry[0];\nconst change = entry && entry.changes && entry.changes[0];\nconst value = change && change.value;\nconst message = value && value.messages && value.messages[0];\n\nconst from = message ? message.from : null;\nconst text = message && message.text ? message.text.body : '';\nconst contactName = value && value.contacts && value.contacts[0] && value.contacts[0].profile\n  ? value.contacts[0].profile.name : 'Customer';\n\nreturn [{\n  json: {\n    from,\n    text,\n    contactName,\n    sessionId: `wa_${from}`,\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "ad573302-40a5-4d7b-a272-522e930df0be",
      "name": "Normalize WhatsApp Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2048,
        1456
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "ChatState",
          "mode": "list"
        },
        "options": {}
      },
      "id": "a489060b-81ff-458f-ba08-15ad4860ec0e",
      "name": "Lookup Chat State",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2048,
        1664
      ]
    },
    {
      "parameters": {
        "jsCode": "// Merge lookup result with the incoming message data\n// If no row found for this chat, default takeover = false (bot handles it)\nconst incoming = $('Normalize WhatsApp Message').item.json;\nconst stateRows = items.map(i => i.json).filter(r => r.ChatId);\nconst state = stateRows.find(r => String(r.ChatId) === String(incoming.from));\n\nconst takeover = state ? String(state.Takeover).toLowerCase() === 'true' : false;\n\nreturn [{\n  json: {\n    ...incoming,\n    takeover,\n    rowExists: !!state\n  }\n}];"
      },
      "id": "1d441dfd-cab3-4374-9654-5547fc192139",
      "name": "Merge Chat State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2352,
        1408
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.takeover }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d3a87e1f-c79a-4464-969f-ca23794e179c",
      "name": "IF Human Already Handling?",
