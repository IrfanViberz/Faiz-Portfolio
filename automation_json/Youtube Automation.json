    {
      "parameters": {
        "jsCode": "// Runs once per scene inside the loop. Attach public URLs for downstream assembly.\nconst item = $input.first().json;\nreturn [{\n  json: {\n    sceneIndex: item.sceneIndex,\n    narration: item.narration,\n    duration_seconds: item.duration_seconds,\n    audio_url: item.webViewLink || item.webContentLink,\n    image_url: item.output ? item.output[0] : item.image_url,\n    videoMeta: item.videoMeta\n  }\n}];"
      },
      "id": "9dbeeeba-a22c-4e59-8f70-228711c2d33e",
      "name": "Normalize Scene Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2048,
        176
      ]
    },
    {
      "parameters": {},
      "id": "fa05bcb3-9c7e-4fbb-80b3-171dbb4ac832",
      "name": "Merge Loop Back",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2272,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "// After the Loop Over Scenes node finishes iterating, all scene items land here.\n// Build the Creatomate render template.\nconst items = $input.all().map(i => i.json);\nconst videoMeta = items[0].videoMeta;\n\nconst elements = [];\nlet track = 1;\nfor (const scene of items) {\n  elements.push({\n    type: \"image\",\n    track,\n    source: scene.image_url,\n    duration: scene.duration_seconds\n  });\n  elements.push({\n    type: \"audio\",\n    track: track + 1,\n    source: scene.audio_url,\n    duration: scene.duration_seconds\n  });\n  elements.push({\n    type: \"text\",\n    track: track + 2,\n    text: scene.narration,\n    duration: scene.duration_seconds,\n    y: \"80%\",\n    font_family: \"Montserrat\",\n    font_weight: \"700\",\n    fill_color: \"#ffffff\",\n    background_color: \"rgba(0,0,0,0.6)\"\n  });\n  track += 3;\n}\n\nreturn [{\n  json: {\n    source: {\n      output_format: \"mp4\",\n      width: 1080,\n      height: 1920,\n      elements\n    },\n    videoMeta\n  }\n}];"
      },
